//name: Entra ID - All sign-ins without conditional access policy or MFA - LAW
//updated: 2026-4-20
//description:
//Use this query in Log Analytics Workspace.
//This query returns all sign-ins where neither MFA was required nor conditional access policies were applied.
//Uncomment last line to get a count of all applications by user.
SigninLogs
| extend device = todynamic(DeviceDetail)
| extend deviceTrust = device.trustType
| extend deviceName = device.deviceName
| where TimeGenerated > ago(30d)
| where UserType == "Member" // Filter out logins of users who are also guests in other tenants
| where deviceTrust != "Hybrid Azure AD joined" // Filter for Hybrid Joined devices if CA is using this as grant condition
| where AuthenticationRequirement != "multiFactorAuthentication"
| where ConditionalAccessStatus == "notApplied"
| where ResultType  == "0" // Auth codes = https://learn.microsoft.com/en-us/entra/identity-platform/reference-error-codes
| where not(AppDisplayName has_any ("Windows Sign In", "Microsoft Authentication Broker", "APP3")) // Add more applications that can be excluded
| where not(ResourceDisplayName has_any ("OCaaS Client Interaction Service", "RESOURCE2")) // OCaaS is a Microsoft Service present by default in all Entra ID tenants. It has pre-consented permissions without being touched by CA.
| project
    TimeGenerated,
    UserPrincipalName,
    UserDisplayName,
    UserType,
    IPAddress,
    Location,
    NetworkLocationDetails,
    ResultType,
    AppDisplayName,
    ResourceDisplayName,
    ResourceTenantId,
    AuthenticationRequirement,
    ConditionalAccessStatus,
    ConditionalAccessPolicies,
    deviceTrust,
    deviceName,
    ClientAppUsed,
    UserAgent,
    UserId,
    AppId,
    CorrelationId
| sort by TimeGenerated desc
