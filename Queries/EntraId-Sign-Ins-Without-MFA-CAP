//name: Entra ID - All sign-ins without conditional access policy or MFA
//updated: 2026-4-20
//description:
//Use this query in Advanced Hunting.
//This query returns all sign-ins where neither MFA was required nor conditional access policies were applied.
//Uncomment last line to get a count of all applications by user.
EntraIdSignInEvents
| where Timestamp > ago(30d)
| where IsGuestUser == 0 // Filter out logins of users who are also guests in other tenants
| where DeviceTrustType != "Hybrid Azure AD joined" // Filter for Hybrid Joined devices if CA is using this as grant condition
| where AuthenticationRequirement != "multiFactorAuthentication"
| where ConditionalAccessStatus in ("0","2") // 0 = Policy applied or 2 = Ppolicy was not applied
| where ErrorCode == "0" // Auth codes = https://learn.microsoft.com/en-us/entra/identity-platform/reference-error-codes
| where LogonType != '["nonInteractiveUser"]' // Only interactive logons ... see https://learn.microsoft.com/en-us/windows/win32/secauthn/noninteractive-authentication
| where not(Application has_any ("Windows Sign In", "Microsoft Authentication Broker", "APP3")) // Add more applications that can be excluded
| where not(ResourceDisplayName has_any ("OCaaS Client Interaction Service", "RESOURCE2")) // OCaaS is a Microsoft Service present by default in all Entra ID tenants. It has pre-consented permissions without being touched by CA.
| project
    Timestamp,
    AccountUpn,
    AccountDisplayName,
    IsGuestUser,
    LogonType,
    IPAddress,
    Country,
    NetworkLocationDetails,
    ErrorCode,
    Application,
    ResourceDisplayName,
    ResourceTenantId,
    AuthenticationRequirement,
    ConditionalAccessStatus,
    ConditionalAccessPolicies,
    DeviceName,
    DeviceTrustType,
    ClientAppUsed,
    UserAgent,
    AccountObjectId,
    ApplicationId,
    CorrelationId
| sort by Timestamp desc
